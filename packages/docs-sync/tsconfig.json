{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "lib": ["ESNext", "DOM"],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
